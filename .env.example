# Every variable the binary reads, with its default. Compose sets them for the stack; nothing
# here is secret, and .env (ignored) is where a local override goes.

# The database, required; the service exits without it.
DATABASE_URL=postgres://wdig:wdig@db:5432/wdig
# Where the service listens.
BIND_ADDR=0.0.0.0:8080
# development or production: development allows LOG_FORMAT=pretty.
APP_ENV=development
# The tracing filter.
RUST_LOG=info
