# Every secret the stack reads, by name. The values live only in
# deploy/ovh/wdig.enc.env, encrypted with sops to the two keys in .sops.yaml, and go
# in one at a time from a hidden prompt:
#
#   make ovh-secrets-set KEY=GHCR_READ_TOKEN
#
# Nothing is ever filled in here. `make ovh-secrets-show` lists the names the encrypted file
# holds, never their values.

# The host's own needs (CONTRACT.md §4): pulling the private image with a classic PAT that
# has read:packages and nothing else.
GHCR_USER=
GHCR_READ_TOKEN=

# A Healthchecks.io check per scheduled job, if the service has any.
# HEALTHCHECKS_ENABLED=true
# HEALTHCHECKS_PROJECT_PING_KEY=
